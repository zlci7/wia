{
  "name": "wia-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend for World Is Agent. Built assets are copied into the Runtime's embed package.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-dist.mjs && vite build && node scripts/embed-dist.mjs",
    "embed-dist": "node scripts/embed-dist.mjs",
    "type-check": "vue-tsc --noEmit",
    "test:reading": "node scripts/check-reading.mjs",
    "test:creation": "node scripts/check-creation-play.mjs",
	"test:progress": "node scripts/check-run-progress.mjs",
    "test:settings": "node scripts/check-settings.mjs",
    "test:memory": "node scripts/check-memory.mjs",
    "test:creator": "node scripts/check-creator.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  }
}

# Build outputs
bin/
obj/
backend/server.exe
# The refactor tools are run with `go run .`, which leaves nothing behind. A compiled
# copy was committed once; a 4 MB binary should never be tracked again.
tools/refactor/*.exe

# Release archives produced by scripts/release-runtime.ps1. A package is built
# from a tag, so a checked-in archive could only be stale.
dist/

# The client build. dist/ is produced from frontend/ and copied into the embed
# package; only the placeholder that keeps the embed pattern valid is tracked, so
# a checked-in bundle can never drift from its source.
frontend/dist/
backend/internal/webdist/dist/*
!backend/internal/webdist/dist/.gitkeep
frontend/node_modules/

# IDE/editor state
.vs/
.vscode/
.idea/
*.user
*.suo

# OS noise
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp
*.stackdump
backend/.local/
backend/data/

# Go local artifacts
*.test
coverage.out
.gocache/

# Local private config overrides
backend/config/*.local.json

# Credentials. The development data root is inside the repository, so a secret
# written to <root>/secrets/ during local testing must never be committable.
backend/secrets/

# AGENTS.md is tracked: it is the repository's standing agent instructions.

# Local-only agent instructions
AGENTS.local.md

docs/roadmap/

docs/archive/
docs/pro/

.obsidian/
.gstack/

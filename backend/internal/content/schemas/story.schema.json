{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spatial": {
          "const": 1
        },
        "state": {
          "const": 1
        },
        "relations": {
          "const": 1
        },
        "items": {
          "const": 1
        },
        "rules": {
          "const": 1
        },
        "progression": {
          "const": 1
        }
      },
      "minProperties": 1
    },
    "materials_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "data_files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locations": {"type": "string", "minLength": 1, "maxLength": 240},
        "progression": {"type": "string", "minLength": 1, "maxLength": 240},
        "state": {"type": "string", "minLength": 1, "maxLength": 240},
        "relations": {"type": "string", "minLength": 1, "maxLength": 240},
        "items": {"type": "string", "minLength": 1, "maxLength": 240},
        "rules": {"type": "string", "minLength": 1, "maxLength": 240},
        "bystanders": {"type": "string", "minLength": 1, "maxLength": 240}
      },
      "required": ["locations"]
    },
    "game_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "open",
        "guided"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "gameplay": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "background": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8000
    },
    "rules": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8000
    },
    "author_facts": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8000
    },
    "cover": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^assets/"
    },
    "cover_alt": {
      "type": "string",
      "minLength": 0,
      "maxLength": 300
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "profile": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "requirements": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "editable": {
          "type": "boolean"
        },
        "initial_state": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "maxProperties": 32
        }
      },
      "required": []
    },
    "opening": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "initial_location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
    },
    "clock": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^第 [1-9][0-9]{0,3} 日 ([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "region",
              "place"
            ]
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
            },
            "minItems": 0,
            "maxItems": 32
          },
          "public": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "connections"
        ]
      },
      "minItems": 1,
      "maxItems": 32
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^npcs/.+\\.json$"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "bystanders": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bystander_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^bystander:[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "minLength": 0,
                "maxLength": 2000
              },
              "initial_location": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
              },
              "avatar": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^assets/"
              }
            },
            "required": [
              "bystander_id",
              "name"
            ]
          }
        ]
      },
      "minItems": 0,
      "maxItems": 40
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
        },
        "facts": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8000
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
                },
                "minItems": 0,
                "maxItems": 64
              },
              "at_minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5256000
              },
              "condition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "development": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "audience": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 84
                },
                "minItems": 0,
                "maxItems": 17
              },
              "terminal": {
                "type": "boolean"
              },
              "requirements": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "$ref": "#/$defs/factCondition"
                }
              },
              "on_unmet": {
                "enum": [
                  "defer",
                  "skip"
                ]
              }
            },
            "required": [
              "id",
              "after",
              "condition",
              "development",
              "audience"
            ]
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "revision",
        "nodes"
      ]
    },
    "event_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "locations",
        "participants",
        "max_active",
        "cooldown_turns"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "participants": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 84
          }
        },
        "max_active": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cooldown_turns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        }
      }
    },
    "state_definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "enum": [
              "integer",
              "boolean",
              "enum"
            ]
          },
          "minimum": {
            "type": "integer"
          },
          "maximum": {
            "type": "integer"
          },
          "enum_values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "default": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "scope": {
            "enum": [
              "player",
              "npc",
              "all"
            ]
          },
          "projection": {
            "enum": [
              "self",
              "public",
              "hidden"
            ]
          },
          "knowledge": {
            "enum": [
              "owner",
              "public",
              "host_only"
            ]
          },
          "update_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "readonly",
                  "model",
                  "bounded_proposal",
                  "rule_only"
                ]
              },
              "max_change_per_turn": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "kind"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "default",
          "scope",
          "projection",
          "knowledge",
          "update_policy"
        ]
      }
    },
    "relation_definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minimum": {
            "type": "integer"
          },
          "maximum": {
            "type": "integer"
          },
          "default": {
            "type": "integer"
          },
          "max_change_per_turn": {
            "type": "integer",
            "minimum": 0
          },
          "projection": {
            "enum": [
              "self",
              "public",
              "hidden"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "name",
          "minimum",
          "maximum",
          "default",
          "max_change_per_turn",
          "projection"
        ]
      }
    },
    "initial_relations": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 84
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 84
          },
          "relation_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "value": {
            "type": "integer"
          }
        },
        "required": [
          "subject_id",
          "target_id",
          "relation_type",
          "value"
        ]
      }
    },
    "item_definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "projection": {
            "enum": [
              "public",
              "holder",
              "hidden"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "projection"
        ]
      }
    },
    "item_instances": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "definition_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "holder_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 84
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "instance_id",
          "definition_id"
        ],
        "oneOf": [
          {
            "required": [
              "holder_id"
            ]
          },
          {
            "required": [
              "location_id"
            ]
          }
        ]
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "perspective": {
          "type": "string",
          "enum": [
            "first_person",
            "second_person",
            "third_person"
          ]
        },
        "length": {
          "type": "string",
          "enum": [
            "concise",
            "standard",
            "detailed"
          ]
        },
        "detail": {
          "type": "string",
          "enum": [
            "restrained",
            "balanced",
            "rich"
          ]
        },
        "player_elaboration": {
          "type": "string",
          "enum": [
            "restrained",
            "natural",
            "expressive"
          ]
        },
        "npc_initiative": {
          "type": "string",
          "enum": [
            "responsive",
            "contextual",
            "proactive"
          ]
        },
        "custom_instruction": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "behavior_policies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coordination": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            "narration": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            "npc": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "action_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "guidance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "conditions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/factCondition"
            }
          },
          "risk": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "base_target": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "minimum": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "maximum": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "modifiers": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": -100,
                      "maximum": 100,
                      "not": {
                        "const": 0
                      }
                    },
                    "condition": {
                      "$ref": "#/$defs/factCondition"
                    }
                  },
                  "required": [
                    "label",
                    "amount",
                    "condition"
                  ]
                }
              }
            },
            "required": [
              "base_target",
              "minimum",
              "maximum"
            ]
          },
          "success_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "failure_text": {
            "type": "string",
            "maxLength": 1000
          },
          "success_effects": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/ruleEffect"
            }
          },
          "failure_effects": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/ruleEffect"
            }
          }
        },
        "required": [
          "id",
          "name",
          "guidance",
          "success_text"
        ]
      }
    }
  },
  "$defs": {
    "factCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "location_is",
            "state_at_least",
            "state_at_most",
            "relation_at_least",
            "relation_at_most",
            "item_held",
            "item_at",
            "rule_result",
            "rule_result_absent"
          ]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 84
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 84
        },
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "location_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "ruleEffect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "state_delta"
        },
        "entity_id": {
          "enum": [
            "actor",
            "player"
          ]
        },
        "state_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "delta": {
          "type": "integer",
          "not": {
            "const": 0
          }
        }
      },
      "required": [
        "kind",
        "entity_id",
        "state_id",
        "delta"
      ]
    }
  },
  "required": [
    "schema_version",
    "game_id",
    "revision",
    "mode",
    "title",
    "description",
    "gameplay",
    "opening",
    "initial_location",
    "clock",
    "npcs"
  ],
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 4}}, "required": ["schema_version"]},
      "then": {
        "required": ["materials_file", "data_files", "requires"],
        "properties": {"mode": {"const": "open"}},
        "not": {"anyOf": [
          {"required": ["background"]}, {"required": ["rules"]}, {"required": ["author_facts"]},
          {"required": ["locations"]}, {"required": ["bystanders"]}, {"required": ["plot"]},
          {"required": ["event_generation"]}, {"required": ["state_definitions"]},
          {"required": ["relation_definitions"]}, {"required": ["initial_relations"]},
          {"required": ["item_definitions"]}, {"required": ["item_instances"]}, {"required": ["action_rules"]}
        ]}
      },
      "else": {
        "required": ["locations"],
        "not": {"anyOf": [{"required": ["materials_file"]}, {"required": ["data_files"]}]}
      }
    }
  ]
}
